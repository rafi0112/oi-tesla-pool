POSTGRES_USER=tesla
POSTGRES_PASSWORD=change_me-change_me
POSTGRES_DB=tesla_pool
# DATABASE_URL=postgresql://tesla:change_me@localhost:5433/tesla_pool
DATABASE_URL=postgresql://postgres.ajtojycewppdcwoqqglt:change_me-change_me@aws-0-ap-southeast-2.pooler.supabase.com:6543/postgres

# Auth is Supabase's own now (see docs/ASSUMPTIONS.md #26) — all three come
# from your Supabase project's Settings > API page. The service role key is
# secret: server-side only, never in web/.env or the frontend bundle.
SUPABASE_URL=https://ajtojycewppdcwoqqglt.supabase.co
SUPABASE_ANON_KEY=replace_with_your_projects_anon_key
SUPABASE_SERVICE_ROLE_KEY=replace_with_your_projects_service_role_key

API_PORT=4000

# Optional. `npm test` runs with NODE_ENV=test and, unless this is set, uses
# DATABASE_URL with a _test suffix — created and migrated automatically. Tests
# truncate every table, and refuse to run against a database not named *_test.
# Auth-gated tests also need real Supabase Auth users behind this database —
# see docs/ASSUMPTIONS.md #26 for what that now requires.
# TEST_DATABASE_URL=postgresql://tesla:change_me@localhost:5433/tesla_pool_test
